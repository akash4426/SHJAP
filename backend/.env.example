# ─── Database ───────────────────────────────────────────────────────────────
# Optional for local runs: when omitted, the app/scripting falls back to
#   postgresql://postgres:1234@localhost:5432/shjap_grievance?schema=public
# and `npm run db:setup` prepares schema + demo data. Production MUST set
# DATABASE_URL explicitly (the API refuses to boot without it).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shjap_grievance?schema=public"

# ─── JWT ────────────────────────────────────────────────────────────────────
# One signing secret; tokens carry typ: access | refresh | mfa
JWT_SECRET="CHANGE-ME-min-32-chars-random-value"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── MFA ────────────────────────────────────────────────────────────────────
MFA_ISSUER="SHJAP Grievance Portal"

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"          # development | production
FRONTEND_URL="http://localhost:5173"

# ─── File Storage ───────────────────────────────────────────────────────────
# local = private server directory (default; files streamed only after authz)
# s3    = any S3-compatible object store (files served via short-lived presigned URLs)
STORAGE_DRIVER="local"
EVIDENCE_LOCAL_DIR="../storage/evidence"
# Optional external malware scanner endpoint: POST octet-stream → {"clean":bool}
# MALWARE_SCAN_URL=""

# S3-compatible settings (when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="shjap-evidence"

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300              # global requests / window
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=50          # /api/auth/* requests / minute (per IP); per-account
                                # brute-force lockout is enforced separately
                                # (MAX_FAILED_LOGINS)

# ─── Security ───────────────────────────────────────────────────────────────
MAX_FAILED_LOGINS=5             # failed password attempts before account lockout

# ─── File Upload ────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760          # 10 MB
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# ─── Workflow ───────────────────────────────────────────────────────────────
DUPLICATE_WINDOW_HOURS=24       # same-title duplicate protection window

# ─── Email (optional; notifications are email-ready) ────────────────────────
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="SHJAP Grievance Portal <noreply@shjap.edu>"
