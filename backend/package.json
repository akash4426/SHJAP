{
  "name": "shjap-grievance-portal-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma",
    "db:push": "prisma db push --schema ../prisma/schema.prisma --skip-generate",
    "db:migrate": "prisma migrate dev --schema ../prisma/schema.prisma",
    "db:seed": "tsx ../prisma/seed.ts",
    "db:setup": "tsx scripts/db-prepare.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:prepare": "tsx scripts/e2e-prepare.ts",
    "e2e": "cd .. && npx playwright test --config tests/e2e/playwright.config.ts",
    "lint": "eslint src --ext .ts",
    "db:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.535.0",
    "@aws-sdk/s3-request-presigner": "^3.535.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.10.0",
    "@supabase/supabase-js": "^2.118.0",
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma"
  }
}
