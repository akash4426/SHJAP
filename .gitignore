# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Builds / generated ──────────────────────────────────────────────────────
backend/dist/
frontend/dist/
*.tsbuildinfo

# ─── Environment secrets (never commit) ──────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env.*
!.env.example
!**/.env.example

# ─── Private evidence storage (runtime data — never commit) ───────────────────
storage/evidence/*
!storage/evidence/.gitkeep

# ─── Test artifacts ──────────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
coverage/
.shjap-e2e/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
desktop.ini

# ─── Package managers / deploy caches ────────────────────────────────────────
.npm/
.vercel/
.next/
